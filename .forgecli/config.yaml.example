providers:
  - name: anthropic-official
    protocol: anthropic
    base_url: https://api.anthropic.com
    api_key: ""  # 留空时读取 ANTHROPIC_API_KEY 环境变量
    model: claude-sonnet-4-20250514
    thinking: true

  # OpenAI provider example
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: ""  # 留空时读取 OPENAI_API_KEY 环境变量
  #   model: gpt-4o

permission_mode: default

mcp_servers: []  # 按需启用；默认不下载或启动第三方服务

  # stdio 示例：启用前安装 Node.js，并确认信任该服务及所用版本。
  # 将上面的 [] 改为以下列表：
  # - name: context7
  #   command: npx
  #   args: ["-y", "@upstash/context7-mcp"]

  # Streamable HTTP example (2025-03-26 spec, default when url is set):
  # 填写服务的最终地址；客户端不会自动跟随 HTTP 重定向。
  # - name: my-http-mcp
  #   url: https://example.com/mcp
  #   transport: http   # optional; "http" (default) or "sse"
  #   headers:
  #     Authorization: "Bearer ${MY_TOKEN}"

enable_coordinator_mode: false   # 设为 true 后创建 Team 时 Lead 只能调度不能写代码
